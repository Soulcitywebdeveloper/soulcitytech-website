# ─────────────────────────────────────────────────────────────
# SoulcityTech — environment variables (placeholders only)
# Copy to `.env` for local development. Set the same values in
# Vercel → Project → Settings → Environment Variables for production.
# NEVER commit a real .env file.
# ─────────────────────────────────────────────────────────────

# ── Public (exposed to the browser; must start with VITE_) ───
# Public website URL, no trailing slash. Used for canonical/OG URLs, sitemap, robots.
VITE_SITE_URL=https://www.example.com

# Business WhatsApp number: international format, digits only (no +, spaces or dashes).
# Example format: 234XXXXXXXXXX. If empty/invalid, WhatsApp buttons fall back to the contact form.
VITE_WHATSAPP_NUMBER=

# Optional public contact details. Leave empty to hide them from the site.
VITE_CONTACT_EMAIL=
VITE_PHONE_NUMBER=

# Optional verified social profile URLs. Leave empty to hide.
VITE_LINKEDIN_URL=
VITE_FACEBOOK_URL=
VITE_INSTAGRAM_URL=
VITE_X_URL=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable analytics
# and the cookie consent banner.
VITE_GA_MEASUREMENT_ID=

# Google Search Console verification token (the content="" value of the meta tag). Optional.
VITE_GSC_VERIFICATION=

# ── Server-only (Vercel serverless function /api/leads) ──────
# Do NOT prefix these with VITE_. They must never reach the browser.

# Resend (https://resend.com) — transactional email for lead notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where new-lead notifications are sent (comma-separate for several recipients)
LEADS_TO_EMAIL=leads@example.com
# Verified sender, e.g.  SoulcityTech Website <leads@yourdomain.com>
LEADS_FROM_EMAIL=SoulcityTech Website <leads@example.com>

# Optional: persist leads in Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional table name (default: leads)
SUPABASE_LEADS_TABLE=leads

# Optional: extra origins allowed to POST to /api/leads (comma-separated),
# e.g. a preview domain. The deployment's own host is always allowed.
ALLOWED_ORIGINS=
