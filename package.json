{
  "name": "soulcitytech-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "SoulcityTech marketing website with WhatsApp and lead capture",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "seo": "node scripts/generate-seo.mjs",
